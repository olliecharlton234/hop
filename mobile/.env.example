# HOP environment variables
# Copy to .env (or .env.local) for local development. In Vercel, add them under
# Project → Settings → Environment Variables. Never commit a real .env file.
#
# PUBLIC values: anything prefixed EXPO_PUBLIC_ is compiled into the app and visible to every
# visitor. Only put browser-safe values here.
#
# PRIVATE values (server secrets) must NEVER be prefixed EXPO_PUBLIC_ and must never be
# imported by app code. V6.1 has none.

# ---- Links ---------------------------------------------------------------------------
# Public base URL used in shared links. Optional on web (the current domain is used), but set
# it once you attach a custom domain so links shared from the native app point to the web beta.
EXPO_PUBLIC_APP_URL=

# ---- Web map (public) ------------------------------------------------------------------
# Defaults to Esri's keyless dark basemap. To use a keyed provider (Mapbox, MapTiler, Stadia),
# paste its tile URL template here and restrict the key to your domains in that provider's
# dashboard (e.g. your-project.vercel.app, gethop.app, localhost).
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_LABELS_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=

# ---- Analytics (optional, public) --------------------------------------------------------
# PostHog project API key (starts with phc_). It is write-only and safe in the browser.
# Leave empty to keep analytics local (events are only logged in development).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Feedback (optional, public) ---------------------------------------------------------
# A form link (Tally, Google Forms, Typeform) and/or an email address. "Send feedback" in
# Profile uses the form if set, otherwise email. Hidden if neither is set.
EXPO_PUBLIC_FEEDBACK_URL=
EXPO_PUBLIC_FEEDBACK_EMAIL=

# ---- V7: Supabase ------------------------------------------------------------------------
# The project URL and anon key are public by design (row-level security protects the data).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# PRIVATE — server only (Edge Functions / CI). Never prefix with EXPO_PUBLIC_, never commit.
# SUPABASE_SERVICE_ROLE_KEY=
